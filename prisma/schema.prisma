generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ULTRA
}

enum ProjectStatus {
  ANALYZING
  BUILDING
  RUNNING
  TESTING
  FIXING
  DEPLOYING
  COMPLETED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  tokensUsed    Int       @default(0)
  tokensLimit   Int       @default(10000)
  stripeId      String?
  paypalId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]
  subscriptions Subscription[]
  chatMessages  ChatMessage[]
  conversations ChatConversation[]
  chatRequests  ChatRequest[]
  uploads       FileUpload[]
}

model ChatConversation {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  mode      String   @default("chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatRequest {
  id        String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lease     String
  createdAt DateTime @default(now())

  @@id([userId, id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  imagePath String?
  attachmentMime String?
  conversationId String?
  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId String?
  toolResult Json?
  createdAt DateTime @default(now())

  @@unique([userId, requestId, role])
  @@index([userId, conversationId, createdAt])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FileUpload {
  id        String   @id
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  ext       String
  createdAt DateTime @default(now())
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan
  status          String   @default("active")
  stripeSubId     String?
  paypalSubId     String?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([stripeSubId])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String        @default("website")
  status      ProjectStatus @default(ANALYZING)
  qualityScore Float        @default(0)
  inputType   String        @default("prompt")
  inputData   String?
  analysis    String?
  outputPath  String?
  agents      AgentRun[]
  artifact    ProjectArtifact?
  requestId   String?
  conversations ChatConversation[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, requestId])
}

model ProjectArtifact {
  projectId String   @id
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files     Json
  manifest  Json
  createdAt DateTime @default(now())
}

model AgentRun {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId   String
  agentName String
  status    String   @default("pending")
  output    String?
  duration  Int?
  createdAt DateTime @default(now())
}

model SystemMetric {
  id        String   @id @default(cuid())
  key       String
  value     Float
  metadata  String?
  createdAt DateTime @default(now())
}
