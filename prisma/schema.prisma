generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ULTRA
}

enum ProjectStatus {
  ANALYZING
  BUILDING
  RUNNING
  TESTING
  FIXING
  DEPLOYING
  COMPLETED
  FAILED
}

enum ResearchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  tokensUsed    Int       @default(0)
  tokensLimit   Int       @default(10000)
  stripeId      String?
  paypalId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]
  subscriptions Subscription[]
  payments      Payment[]
  chatMessages  ChatMessage[]
  conversations ChatConversation[]
  chatRequests  ChatRequest[]
  uploads       FileUpload[]
  researchJobs  ResearchJob[]
  imageJobs     ImageJob[]
  personalMemory PersonalMemory?
  reminders     Reminder[]
  telegramPairingChallenge TelegramPairingChallenge?
  telegramBinding TelegramBinding?
  walletInvestmentSettings WalletInvestmentSettings?
}

model TelegramPairingChallenge {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
}

model TelegramBinding {
  id             String           @id
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId         BigInt           @unique
  telegramUserId BigInt           @unique
  conversationId String
  updates        TelegramUpdate[]
}

enum TelegramMediaOperation {
  generate_image
  edit_image
}

model TelegramUpdate {
  updateId            BigInt           @id
  bindingId           String?
  binding             TelegramBinding? @relation(fields: [bindingId], references: [id], onDelete: SetNull)
  receivedAt          DateTime
  replyDeliveredAt    DateTime?
  replyMessageId      BigInt?
  reportClaimedAt     DateTime?
  attachmentClaimedAt DateTime?
  mediaOperation      TelegramMediaOperation?
  mediaFileId         String?
  mediaMimeType       String?
  mediaFileSize       Int?
  mediaClaimedAt      DateTime?

  @@index([bindingId])
  @@unique([bindingId, replyMessageId])
  @@index([receivedAt])
}

enum WalletInvestmentAiAccess {
  OFF
  ANALYSIS_ONLY
}

enum WalletInvestmentTargetPeriod {
  DAY
  CUSTOM_DAYS
  WEEK
  MONTH
}

model WalletInvestmentSettings {
  userId                    String                        @id
  user                      User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency                  String?
  authorizedAmountMinor     BigInt?
  aiAccess                  WalletInvestmentAiAccess      @default(OFF)
  accessRevision            Int                           @default(0)
  instrumentCode            String?
  strategyLabel             String?
  targetPeriod              WalletInvestmentTargetPeriod?
  targetDays                Int?
  targetAmountMinor         BigInt?
  targetReturnBps           Int?
  targetStartDate           DateTime?                     @db.Date
  tradingConsentRevokedAt   DateTime?
  updatedAt                 DateTime                      @updatedAt
}

model PersonalMemory {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  notes     Json     @default("[]")
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ResearchJob {
  id         String         @id
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId  String
  topic      String
  status     ResearchStatus @default(QUEUED)
  stage      Int            @default(0)
  evidence   Json?
  warnings   String[]       @default([])
  report     String?
  error      String?
  runnerId   String?
  leaseUntil DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, requestId])
}

enum ImageJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ImageJob {
  id         String         @id
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId  String
  toolId     String
  prompt     String
  uploadId   String?
  outputId   String?
  status     ImageJobStatus @default(QUEUED)
  runAfter   DateTime       @default(now())
  runnerId   String?
  leaseUntil DateTime?
  error      String?
  retryable  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, requestId])
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model Reminder {
  id           String                 @id
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId    String
  text         String
  timeZone     String
  localTime    String
  repeat       ReminderRepeat         @default(NONE)
  nextLocal    String?
  nextAt       DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  occurrences  ReminderOccurrence[]

  @@unique([userId, requestId])
  @@index([userId, nextAt])
}

model ReminderOccurrence {
  id             String    @id
  reminderId     String
  reminder       Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  dueAt          DateTime
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([reminderId, dueAt])
  @@index([reminderId, acknowledgedAt])
}

model ChatConversation {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  mode      String   @default("chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatRequest {
  id        String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lease     String
  createdAt DateTime @default(now())

  @@id([userId, id])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  imagePath String?
  attachmentMime String?
  conversationId String?
  conversation ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId String?
  toolResult Json?
  createdAt DateTime @default(now())

  @@unique([userId, requestId, role])
  @@index([userId, conversationId, createdAt])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model FileUpload {
  id        String   @id
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  ext       String
  createdAt DateTime @default(now())
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan
  status          String   @default("active")
  paymentMethod   String?
  bankReference   String?  @unique
  amountEur       Float?
  stripeSubId     String?
  stripePeriodSubId String?
  stripeSessionId String?
  paypalSubId     String?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        Payment[]

  @@index([stripeSubId])
  @@index([stripePeriodSubId])
  @@index([userId, status])
  @@index([plan, status])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountEur      Float
  currency       String        @default("EUR")
  method         String
  status         String        @default("completed")
  externalId     String?
  reference      String?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        String        @default("website")
  status      ProjectStatus @default(ANALYZING)
  qualityScore Float        @default(0)
  inputType   String        @default("prompt")
  inputData   String?
  analysis    String?
  outputPath  String?
  agents      AgentRun[]
  artifact    ProjectArtifact?
  requestId   String?
  conversations ChatConversation[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, requestId])
}

model ProjectArtifact {
  projectId String   @id
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files     Json
  manifest  Json
  createdAt DateTime @default(now())
}

model AgentRun {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId   String
  agentName String
  status    String   @default("pending")
  output    String?
  duration  Int?
  createdAt DateTime @default(now())
}

model SystemMetric {
  id        String   @id @default(cuid())
  key       String
  value     Float
  metadata  String?
  createdAt DateTime @default(now())
}
