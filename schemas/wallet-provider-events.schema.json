{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalized wallet-provider events",
  "description": "Internal refresh hint emitted after verifying the original Wise delivery, matching its subscription and owner binding, and claiming its delivery ID. Never a source of wallet amounts, deposit confirmation, or transfer instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider", "event", "provider_schema_version", "delivery_id", "subscription_id",
    "provider_profile_id", "provider_balance_id", "currency", "occurred_at", "sent_at"
  ],
  "properties": {
    "provider": { "const": "wise" },
    "event": { "const": "balances#update" },
    "provider_schema_version": { "const": "4.0.0" },
    "delivery_id": { "type": "string", "format": "uuid" },
    "subscription_id": { "type": "string", "format": "uuid" },
    "provider_profile_id": { "$ref": "#/definitions/opaqueWiseNumericId" },
    "provider_balance_id": { "$ref": "#/definitions/opaqueWiseNumericId" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "sent_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "opaqueWiseNumericId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
