{
  "name": "sharkai",
  "version": "1.0.4",
  "description": "SharkAI — Autonomous AI Software Engineering Platform",
  "private": true,
  "main": "electron/main.cjs",
  "author": "SharkAI",
  "scripts": {
    "dev": "next dev --port 3847",
    "build": "prisma generate && next build",
    "postbuild": "node scripts/check-wallet-production-binding.cjs",
    "start": "next start --port 3847",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node scripts/test-suite.cjs",
    "test:all": "node scripts/test-suite.cjs",
    "logo:process": "node scripts/process-logo.cjs",
    "desktop:shortcut": "node scripts/create-desktop-shortcut.cjs",
    "postinstall": "prisma generate",
    "electron:dev": "concurrently -k \"next dev --port 3847\" \"wait-on http://localhost:3847 && electron .\"",
    "electron:build": "node scripts/build-electron.cjs",
    "electron:install": "npm run electron:build && node scripts/install-desktop.cjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/react": "^3.0.199",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.1.0",
    "@vercel/functions": "^3.7.1",
    "@xmldom/xmldom": "^0.9.12",
    "ai": "^6.0.197",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^7.0.3",
    "framer-motion": "^11.15.0",
    "gpt-tokenizer": "^4.1.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "saxes": "^6.0.0",
    "sharp": "^0.34.5",
    "stripe": "^17.5.0",
    "yauzl": "^3.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/yauzl": "^3.4.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "dotenv": "^17.4.2",
    "electron": "45.3.4",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.16",
    "to-ico": "^1.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.sharkai.platform",
    "productName": "SharkAI",
    "directories": {
      "output": "release",
      "app": ".desktop-app"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "en"
      ],
      "language": "1033",
      "shortcutName": "SharkAI",
      "runAfterFinish": true,
      "artifactName": "SharkAI-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ]
  }
}
