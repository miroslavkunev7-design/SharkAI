# SharkAI — Production Environment

POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/postgres"
JWT_SECRET="change-me-long-random-secret"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Monthly subscriptions. Stripe sends signed Checkout/invoice events to /api/payments/webhook.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ULTRA_PRICE_ID=""

# Windows installer. Use the HTTPS URL of SharkAI-Setup-<package version>.exe.
INSTALLER_DOWNLOAD_URL=""
INSTALLER_SIZE_MB=""
# Optional build-time override for an approved SharkAI preview or production origin.
SHARKAI_DESKTOP_ORIGIN=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
USE_DB_UPLOADS="true"

# Optional AI (off by default)
SHARKAI_USE_PAID_AI="false"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_GATEWAY_API_KEY=""

# Optional OpenAI-compatible Chat Completions endpoint. Tools use hosted OpenAI separately.
SHARKAI_OPENAI_CHAT_BASE_URL=""
SHARKAI_OPENAI_CHAT_MODEL=""
SHARKAI_OPENAI_CHAT_API_KEY=""
SHARKAI_OPENAI_CHAT_VISION="false"
