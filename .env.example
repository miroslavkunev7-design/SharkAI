# SharkAI — Production Environment

POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/postgres"
JWT_SECRET="change-me-long-random-secret"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
# Full Git commit for staging hosts that do not provide VERCEL_GIT_COMMIT_SHA.
SHARKAI_BUILD_REVISION=""

# Monthly subscriptions. Stripe sends signed Checkout/invoice events to /api/payments/webhook.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ULTRA_PRICE_ID=""

# Windows installer. Use the HTTPS URL of SharkAI-Setup-<package version>.exe.
INSTALLER_DOWNLOAD_URL=""
INSTALLER_SIZE_MB=""
# Optional build-time override for an approved SharkAI preview or production origin.
SHARKAI_DESKTOP_ORIGIN=""
# Exact email of the existing owner with the ADMIN role and lifetime Ultra.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
USE_DB_UPLOADS="true"

# Optional AI (off by default)
SHARKAI_USE_PAID_AI="false"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_GATEWAY_API_KEY=""

# Optional OpenAI-compatible Chat Completions endpoint. Tools use hosted OpenAI separately.
SHARKAI_OPENAI_CHAT_BASE_URL=""
SHARKAI_OPENAI_CHAT_MODEL=""
SHARKAI_OPENAI_CHAT_API_KEY=""
SHARKAI_OPENAI_CHAT_VISION="false"
# Enables native function calling only on compatible models you have verified.
SHARKAI_OPENAI_CHAT_TOOLS="false"

# Optional image generation and editing worker, configured on the application server.
SHARKAI_IMAGE_WORKER_URL=""
SHARKAI_IMAGE_WORKER_TOKEN=""

# Optional local English-to-Bulgarian document translator.
SHARKAI_TRANSLATION_WORKER_URL=""
SHARKAI_TRANSLATION_WORKER_TOKEN=""

# Optional directory with eng.traineddata and/or bul.traineddata for isolated local OCR.
SHARKAI_OCR_TESSDATA_DIR=""

# Optional private speech service for transcription and spoken responses.
SHARKAI_VOICE_WORKER_URL=""
SHARKAI_VOICE_WORKER_TOKEN=""

# Random dedicated n8n service bearer credential, 32 or more base64url characters.
SHARKAI_TELEGRAM_SERVICE_SECRET=

# Wallet status server-to-server credential for the fixed n8n tool.
SHARKAI_WALLET_STATUS_SERVICE_SECRET=
# Separate backend-only signer for short-lived per-account grants.
SHARKAI_WALLET_STATUS_GRANT_SECRET=

# Wise partner configuration. Use a single owner binding or an approved enrollment list.
WALLET_PROVIDER=
WISE_WALLET_OWNER_BINDING=
WISE_WALLET_OAUTH_ACCESS_TOKEN=
WISE_WALLET_ENROLLMENTS=
WISE_WALLET_CLIENT_CERT_PEM=
WISE_WALLET_CLIENT_KEY_PEM=
WISE_WALLET_SERVER_CA_PEM=

# Private broker forecast ingestion and owner-scoped reads require a reviewed broker account binding.
SHARKAI_BROKER_FORECAST_ENABLED=false
# JSON object keyed by approved connector ID with a unique, random, 32-byte lowercase hex HMAC key per connector.
SHARKAI_BROKER_FORECAST_CONNECTOR_KEYS=

# Dedicated order worker and readback. Provision on the server only after broker approval.
SHARKAI_BROKER_WORKER_ENABLED=false
SHARKAI_BROKER_EVIDENCE_ENABLED=false
SHARKAI_TRADING_CONSENT_ENABLED=false
SHARKAI_TRADING_CONSENT_SECRET=
SHARKAI_DIAGNOSTIC_ACCOUNT_ID=
SHARKAI_ORDER_WORKER_DATABASE_URL=
SHARKAI_ORDER_WORKER_KEYS=
SHARKAI_ORDER_WORKER_CREDENTIALS=
SHARKAI_ORDER_SIGNAL_KEYS=
SHARKAI_ORDER_QUOTE_KEYS=
SHARKAI_ORDER_PROFIT_KEYS=
SHARKAI_ORDER_PROFIT_DATABASE_URL=
SHARKAI_ORDER_SOURCE_DATABASE_URL=
SHARKAI_ORDER_RUNNER_ID=
SHARKAI_ORDER_RUNNER_KEY=
SHARKAI_ORDER_RUNNER_DATABASE_URL=
# Credential for the fixed original Shark AI webhook.
SHARKAI_N8N_AGENT_KEY=

# Statement intake for realized platform fees. Separate report and credit signers, no debit authority.
SHARKAI_FEE_EVIDENCE_ENABLED=false
SHARKAI_FEE_DATABASE_URL=
SHARKAI_FEE_COLLECTOR_KEYS=
SHARKAI_COMMERCE_EVIDENCE_ENABLED=false
SHARKAI_COMMERCE_FULFILLMENT_ENABLED=false
SHARKAI_COMMERCE_PROCUREMENT_ENABLED=false
SHARKAI_COMMERCE_ZOHO_CREDENTIALS=
SHARKAI_COMMERCE_PROCUREMENT_CRON_SECRET=
# Shopify entries use shop + owner_id + shopify_secret + either shopify_client_id or shopify_access_token; Printful fields are optional.
SHARKAI_COMMERCE_STORES=
SHARKAI_COMMERCE_SOURCE_DATABASE_URL=
SHARKAI_COMMERCE_EVIDENCE_KEYS=
SHARKAI_PRINTFUL_WEBHOOK_KEYS=
