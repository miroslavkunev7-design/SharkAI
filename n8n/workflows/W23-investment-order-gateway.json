    {
      "id": "44023564-1061-43c4-a0df-9a0b9c1290e4",
      "name": "Приеми само разрешение за четене",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        245,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items=$input.all();\nconst payload=items.length===1 ? items[0].json : null;\nconst grant=payload?.status_grant;\nconst valid=payload && typeof payload==='object' && !Array.isArray(payload) && Object.keys(payload).length===1\n  && typeof grant==='string' && grant.length>=48 && grant.length<=2048 && /^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/.test(grant);\nreturn [{json:valid ? {status_grant:grant,allowed:true} : {allowed:false}}];"
      }
    },
    {
      "id": "8abea513-c987-4ac4-b4f2-0bb66a91659e",
      "name": "Разрешението е предоставено",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        475,
        100
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "a7a08c70-8dab-44af-b38f-de386ad83743",
              "leftValue": "={{ $json.allowed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "54ff233c-1144-499e-aa37-485a13298f12",
      "name": "Извлечи справката от Shark AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        725,
        70
      ],
      "parameters": {
        "method": "POST",
        "url": "https://mm-auto-green.vercel.app/api/internal/wallet-investments/investment/order-gateway",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shark-Finance-Grant",
              "value": "={{ $json.status_grant }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 6500,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "7e4dc89b-a947-42f6-9b15-da65b7a47d3a",
      "name": "Достъпност на поръчките",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        975,
        70
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const operation=\"order-gateway\";\nconst supportedCodes=[\"ORDER_EXECUTION_NOT_ENABLED\",\"AUTOMATED_WORKER_STATUS\"];\nconst response=$input.first().json;\nconst body=response?.body;\nconst reject = (code) => [{json:{status:'unavailable',code,operation,source:'shark-ai-investments',\n  mode:'READ_ONLY',live_orders_enabled:false,timestamp:new Date().toISOString(),data:null}}];\nif (response?.statusCode!==200) return reject(response?.statusCode===403 ? 'FINANCE_READ_GRANT_DENIED' : 'BACKEND_UNAVAILABLE');\nif (!body || body.source!=='shark-ai-investments' || body.operation!==operation || body.mode!=='READ_ONLY'\n    || body.live_orders_enabled!==false || !supportedCodes.includes(body.code) || !['ok','blocked','unavailable'].includes(body.status)\n    || typeof body.timestamp!=='string' || !Number.isFinite(Date.parse(body.timestamp))\n    || (body.data!==null && typeof body.data!=='object')) return reject('INVALID_PRODUCT_RESPONSE');\nreturn [{json:{ status:body.status,code:body.code,operation,source:body.source,mode:body.mode,\n  live_orders_enabled:false,timestamp:body.timestamp,data:body.data }}];"
      }
    },
    {
      "id": "ce18cda2-66de-40b8-817f-919827c3068c",
      "name": "Върни отказ без заявка",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        725,
        235
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{status:'blocked',code:'FINANCE_READ_GRANT_REQUIRED',operation:\"order-gateway\",\n  source:'shark-ai-investments',mode:'READ_ONLY',live_orders_enabled:false,timestamp:new Date().toISOString(),data:null}}];"
      }
    }
