        "jsCode": "return [{json:{status:'blocked',code:'FINANCE_READ_GRANT_REQUIRED',operation:\"weekly-report\",\n  source:'shark-ai-investments',mode:'READ_ONLY',live_orders_enabled:false,timestamp:new Date().toISOString(),data:null}}];"
      }
    }
