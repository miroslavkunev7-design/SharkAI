    {
      "id": "b30d94b4-c538-4ed5-9388-c71babdb812f",
      "name": "Приеми вътрешна заявка",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
