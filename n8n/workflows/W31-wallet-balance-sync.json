    {
      "id": "6b07b1bc-1a3a-4ccb-9419-9d37e3febf5e",
      "name": "Приеми само разрешение за четене",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        245,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items=$input.all();\nconst payload=items.length===1 ? items[0].json : null;\nconst grant=payload?.status_grant;\nconst valid=payload && typeof payload==='object' && !Array.isArray(payload) && Object.keys(payload).length===1\n  && typeof grant==='string' && grant.length>=48 && grant.length<=2048 && /^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/.test(grant);\nreturn [{json:valid ? {status_grant:grant,allowed:true} : {allowed:false}}];"
      }
    },
    {
      "id": "70587c88-85f7-4abb-b4ef-b886a28b19c5",
      "name": "Разрешението е предоставено",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        475,
        100
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "5c4b94a2-e28d-4449-b499-dfb6fd0b3db0",
              "leftValue": "={{ $json.allowed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "464a907f-aef2-40f7-b3ab-405e74a7ce0e",
      "name": "Извлечи справката от Shark AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        725,
        70
      ],
      "parameters": {
        "method": "POST",
        "url": "https://mm-auto-green.vercel.app/api/internal/wallet-investments/wallet/balance",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shark-Finance-Grant",
              "value": "={{ $json.status_grant }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 6500,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "1bf390a2-b7e8-494d-8482-eb2b05387f50",
      "name": "Баланс на портфейла",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        975,
        70
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const operation=\"balance\";\nconst success=[\"VERIFIED_WALLET_BALANCE\"];\nconst response = $input.first().json;\nconst body = response.body;\nconst fail = code => [{json:{operation,status:'unavailable',code,data:null}}];\nif (response.statusCode !== 200 || !body || body.operation !== operation || body.source !== 'shark-ai-wallet') {\n  return fail(response.statusCode === 403 ? 'FINANCE_READ_GRANT_DENIED' : 'BACKEND_UNAVAILABLE');\n}\nconst observed = Date.parse(body.timestamp);\nif (!Number.isFinite(observed) || observed > Date.now() + 5000 || observed < Date.now() - 300000) return fail('STALE_PROVIDER_STATUS');\nif (body.status === 'unavailable') return fail(['VERIFIED_STATEMENT_REQUIRED','VERIFIED_WALLET_REQUIRED'].includes(body.code) ? body.code : 'BACKEND_UNAVAILABLE');\nconst data = body.data;\nif (body.status !== (operation === 'withdrawal' ? 'needs_human' : 'ok') || !success.includes(body.code) || !data || data.provider !== 'wise') return fail('INVALID_PROVIDER_STATUS');\nif (operation === 'balance' && (data.status !== 'verified' || data.source !== 'wise_balance_api' || !/^(0|[1-9]\\d*)$/.test(data.balance_minor))) return fail('INVALID_PROVIDER_STATUS');\nif (operation === 'deposit' && (data.source !== 'wise_balance_statement' || !Number.isSafeInteger(data.count) || data.count < 0)) return fail('INVALID_PROVIDER_STATUS');\nif (operation === 'withdrawal' && data.provider_home !== 'https://wise.com/home/') return fail('INVALID_PROVIDER_STATUS');\nreturn [{json:{operation,status:body.status,code:body.code,data,timestamp:body.timestamp,source:body.source}}];"
      }
    },
    {
      "id": "dd63c849-4afb-47af-be3c-34dc8a0869f3",
      "name": "Върни отказ без заявка",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        725,
