      "parameters": {
        "width": 1320,
        "height": 425,
        "color": 4,
        "content": "## W21 Анализ и цел\nПрогнозата използва само отделена и уредена реализирана печалба след загуби и такси, до лимита на собственика. При непотвърдена печалба бюджетът е нула. Историческият диапазон може да включва загуби. Периоди: ден, брой дни, седмица и месец."
      }
    },
    {
      "id": "4b943b59-97b6-4806-81ca-2eb8ca84e5bf",
      "name": "Приеми вътрешна заявка",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        100
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "fabec5b4-d061-46e4-b945-55f8d3674e4c",
      "name": "Приеми само разрешение за четене",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        245,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items=$input.all();\nconst payload=items.length===1 ? items[0].json : null;\nconst grant=payload?.status_grant;\nconst valid=payload && typeof payload==='object' && !Array.isArray(payload) && Object.keys(payload).length===1\n  && typeof grant==='string' && grant.length>=48 && grant.length<=2048 && /^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/.test(grant);\nreturn [{json:valid ? {status_grant:grant,allowed:true} : {allowed:false}}];"
      }
    },
    {
      "id": "109a55f2-2bc8-4bf1-81d6-3ead18c219d6",
      "name": "Разрешението е предоставено",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        475,
        100
      ],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "106864d1-81a3-47cb-b6b8-a161c9bb8d06",
              "leftValue": "={{ $json.allowed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6137e581-b13b-42ec-afdb-b0b5b297cfa5",
      "name": "Извлечи справката от Shark AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        725,
        70
      ],
      "parameters": {
        "method": "POST",
        "url": "https://mm-auto-green.vercel.app/api/internal/wallet-investments/investment/analysis",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Shark-Finance-Grant",
              "value": "={{ $json.status_grant }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 6500,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "46dd659b-0030-461c-b0a5-eae85c92f252",
      "name": "Анализ на инвестиции",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        975,
        70
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const operation=\"analysis\";\nconst supportedCodes=[\"VERIFIED_STRATEGY_FORECAST\",\"NO_ELIGIBLE_PROFIT_CAPITAL\",\"VERIFIED_CAPITAL_WITHOUT_FORECAST\",\"STALE_BROKER_FUNDING\",\"VERIFIED_BROKER_FUNDING_REQUIRED\"];\nconst response=$input.first().json;\nconst body=response?.body;\nconst reject = (code) => [{json:{status:'unavailable',code,operation,source:'shark-ai-investments',\n  mode:'READ_ONLY',live_orders_enabled:false,timestamp:new Date().toISOString(),data:null}}];\nif (response?.statusCode!==200) return reject(response?.statusCode===403 ? 'FINANCE_READ_GRANT_DENIED' : 'BACKEND_UNAVAILABLE');\nif (!body || body.source!=='shark-ai-investments' || body.operation!==operation || body.mode!=='READ_ONLY'\n    || body.live_orders_enabled!==false || !supportedCodes.includes(body.code) || !['ok','blocked','unavailable'].includes(body.status)\n    || typeof body.timestamp!=='string' || !Number.isFinite(Date.parse(body.timestamp))\n    || (body.data!==null && typeof body.data!=='object')) return reject('INVALID_PRODUCT_RESPONSE');\nreturn [{json:{ status:body.status,code:body.code,operation,source:body.source,mode:body.mode,\n  live_orders_enabled:false,timestamp:body.timestamp,data:body.data }}];"
      }
    },
    {
      "id": "7ab79e47-ba40-4886-b208-a680fce135f3",
      "name": "Върни отказ без заявка",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
